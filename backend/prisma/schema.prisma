datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model LoanScheme {
  id                 String   @id
  name               String
  annualInterestRate Float
  maxLtv             Float    // Must never exceed 0.75
  tenureMonths       Int
  repaymentType      String   // BULLET, EMI
  description        String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  leads              Lead[]

  @@map("loan_schemes")
}

model Lead {
  id                 String            @id
  customerName       String
  mobileNumber       String
  grossWeightGrams   Decimal           @db.Decimal(8, 3)
  netWeightGrams     Decimal           @db.Decimal(8, 3)
  karat              Int
  planId             String
  pureGoldGrams      Decimal           @db.Decimal(8, 3)
  goldRatePerGram    Decimal           @db.Decimal(10, 2)
  goldValueRupees    Decimal           @db.Decimal(12, 2)
  eligibleLoanRupees Decimal           @db.Decimal(12, 2)
  status             String            @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED
  idempotencyKey     String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  plan               LoanScheme        @relation(fields: [planId], references: [id])
  statusAudits       LeadStatusAudit[]

  @@index([mobileNumber, createdAt])
  @@index([planId])
  @@index([status])
  @@map("leads")
}

model LeadStatusAudit {
  id        String   @id @default(cuid())
  leadId    String
  fromStatus String
  toStatus   String
  changedBy  String   @default("SYSTEM")
  reason     String?
  createdAt  DateTime @default(now())

  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_status_audits")
}
